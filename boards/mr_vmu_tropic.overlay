#include <zephyr/dt-bindings/sensor/icm45686.h>

/ {
	aliases {
		rc = &sbus0;
		imu0 = &icm45686;
		motors = &dshot;
		gnss = &gnss0;
		zros-serial = &lpuart4;

		/*
		 * Candidates for `zros_serial scan`, which listens on all of
		 * them at once to find which header the radio is on. Only
		 * UARTs no driver owns may be listed: the scan reconfigures
		 * the baud and polls for bytes, which would fight any driver
		 * holding the port. lpuart6 is the console, lpuart8 is CRSF,
		 * and lpuart2 belongs to the GNSS receiver in the default
		 * build, so the mocap-gnss snippet adds lpuart2 instead.
		 */
		zros-scan0 = &lpuart3;
		zros-scan1 = &lpuart4;
		zros-scan2 = &lpuart5;
	};
};

/*
 * SiK telemetry radio carrying the compact synapse serial framing. All three
 * candidate TELEM ports carry the radio's rate, not just the one the
 * zros-serial alias currently names: `zros_serial scan` configures the baud
 * itself and restores it afterwards, so a port that scans clean at 57600
 * would otherwise still come up at the devicetree default and see nothing.
 * 57600 is the SiK factory default; change all three together if the radios
 * are reconfigured.
 */
&lpuart3 {
	status = "okay";
	current-speed = <57600>;
};

&lpuart4 {
	status = "okay";
	current-speed = <57600>;
};

&lpuart5 {
	status = "okay";
	current-speed = <57600>;
};

/*
 * Onboard M10 on the 10-pin JST-GH GPS connector. Enabling this node is what
 * pulls in the Zephyr GNSS driver and makes RDD2_GNSS_SOURCE_ONBOARD the
 * default, so the gnss topic is produced here and streamed out as telemetry.
 *
 * current-speed is 115200, confirmed against the hardware: a port dump at that
 * rate returns b5 62 01 07, a u-blox UBX NAV-PVT header. Note that the module
 * therefore speaks UBX, not NMEA, so gnss-nmea-generic cannot decode it - see
 * the GNSS section of README.md. The mocap-gnss snippet disables this node,
 * which both frees the UART and switches the topic to accepting an injected
 * fix.
 */
&lpuart2 {
	status = "okay";
	current-speed = <115200>;

	gnss0: gnss {
		status = "okay";
		compatible = "cognipilot,ubx-gnss";
	};
};

&icm45686 {
	spi-max-frequency = <10000000>;
	/*
	 * Pace the rate loop directly from the IMU data-ready interrupt at
	 * 800 Hz.
	 *
	 * The LPF settings are expressed as a fraction of the ODR, so halving
	 * the ODR while keeping the same fractions would halve both filter
	 * bandwidths. They are widened by one step instead, which holds the
	 * ABSOLUTE bandwidths exactly where they are today: gyro 1600/8 =
	 * 200 Hz becomes 800/4 = 200 Hz, accel 1600/16 = 100 Hz becomes
	 * 800/8 = 100 Hz. Nothing in the control loop or the estimator changes
	 * character, and no phase lag is added to the rate loop; keeping the
	 * fractions would have added roughly 2.4 ms of group delay to the
	 * innermost loop for no benefit.
	 *
	 * Against the rotor content the plant model derives, the hover
	 * fundamental is 120.5 Hz and blade pass is 241 Hz. A gyro corner at
	 * 100 Hz (ODR/8) would sit BELOW the hover fundamental, putting an
	 * always-present tone on the steep part of the response where a small
	 * RPM change becomes a large amplitude and phase change; 200 Hz keeps
	 * the fundamental in the flat band and still rolls off blade pass.
	 * The accel corner stays at 100 Hz, below the fundamental, which is
	 * what is wanted there: vibration on the accelerometer carries no
	 * attitude information the estimator needs.
	 *
	 * Anti-aliasing: Nyquist is 400 Hz and both corners are at or below
	 * half of it, so the first rotor harmonic that folds (2x blade pass at
	 * 482 Hz) is already well down the filter skirt. Preintegrating every
	 * sample in the estimator thread adds a further sinc null at each
	 * multiple of the 100 Hz packet rate.
	 */
	accel-odr = <ICM45686_DT_ACCEL_ODR_800>;
	accel-lpf = <ICM45686_DT_ACCEL_LPF_BW_1_8>;
	gyro-odr = <ICM45686_DT_GYRO_ODR_800>;
	gyro-lpf = <ICM45686_DT_GYRO_LPF_BW_1_4>;
	fifo-watermark = <0>;
};

&pinctrl {
	pinmux_dshot_vmu: pinmux_dshot_vmu {
		group0 {
			pinmux = <&iomuxc_gpio_emc_06_flexio1_flexio06>,
				 <&iomuxc_gpio_emc_07_flexio1_flexio07>,
				 <&iomuxc_gpio_emc_08_flexio1_flexio08>,
				 <&iomuxc_gpio_emc_09_flexio1_flexio09>,
				 <&iomuxc_gpio_emc_02_flexio1_flexio02>,
				 <&iomuxc_gpio_emc_03_flexio1_flexio03>,
				 <&iomuxc_gpio_emc_04_flexio1_flexio04>,
				 <&iomuxc_gpio_emc_05_flexio1_flexio05>;
			drive-strength = "r0-4";
			bias-pull-up;
			bias-pull-up-value = "47k";
			slew-rate = "fast";
			input-enable;
			nxp,speed = "100-mhz";
		};
	};
};

&flexio1 {
	status = "okay";

	dshot: dshot {
		compatible = "cognipilot,flexio-dshot";
		pinctrl-0 = <&pinmux_dshot_vmu>;
		pinctrl-names = "default";
		status = "okay";
		speed = <600>;

		ch1 {
			pin-id = <6>;
		};

		ch2 {
			pin-id = <7>;
		};

		ch3 {
			pin-id = <9>;
		};

		ch4 {
			pin-id = <8>;
		};
	};
};

&bmi08x_accel {
	status = "disabled";
};

&bmi08x_gyro {
	status = "disabled";
};
