#include <zephyr/dt-bindings/sensor/icm45686.h>

/ {
	aliases {
		rc = &crsf0;
		imu0 = &icm45686;
		motors = &dshot;
		gnss = &gnss0;
		zros-serial = &lpuart4;

		/*
		 * Candidates for `zros_serial scan`, which listens on all of
		 * them at once to find which header the radio is on. Only
		 * UARTs no driver owns may be listed: the scan reconfigures
		 * the baud and polls for bytes, which would fight any driver
		 * holding the port. lpuart6 is the console, lpuart8 is CRSF,
		 * and lpuart2 belongs to the GNSS receiver in the default
		 * build, so the mocap-gnss snippet adds lpuart2 instead.
		 */
		zros-scan0 = &lpuart3;
		zros-scan1 = &lpuart4;
		zros-scan2 = &lpuart5;
	};
};

/*
 * SiK telemetry radio carrying the compact synapse serial framing. All three
 * candidate TELEM ports carry the radio's rate, not just the one the
 * zros-serial alias currently names: `zros_serial scan` configures the baud
 * itself and restores it afterwards, so a port that scans clean at 57600
 * would otherwise still come up at the devicetree default and see nothing.
 * 57600 is the SiK factory default; change all three together if the radios
 * are reconfigured.
 */
&lpuart3 {
	status = "okay";
	current-speed = <57600>;
};

&lpuart4 {
	status = "okay";
	current-speed = <57600>;
};

&lpuart5 {
	status = "okay";
	current-speed = <57600>;
};

/*
 * Onboard M10 on the 10-pin JST-GH GPS connector. Enabling this node is what
 * pulls in the Zephyr GNSS driver and makes RDD2_GNSS_SOURCE_ONBOARD the
 * default, so the gnss topic is produced here and streamed out as telemetry.
 *
 * current-speed is 115200, confirmed against the hardware: a port dump at that
 * rate returns b5 62 01 07, a u-blox UBX NAV-PVT header. Note that the module
 * therefore speaks UBX, not NMEA, so gnss-nmea-generic cannot decode it - see
 * the GNSS section of README.md. The mocap-gnss snippet disables this node,
 * which both frees the UART and switches the topic to accepting an injected
 * fix.
 */
&lpuart2 {
	status = "okay";
	current-speed = <115200>;

	gnss0: gnss {
		status = "okay";
		compatible = "cognipilot,ubx-gnss";
	};
};

&icm45686 {
	spi-max-frequency = <10000000>;
	/*
	 * Pace the rate loop directly from the IMU data-ready interrupt at
	 * 1600 Hz. Keep the filter settings conservative enough to cut motor
	 * vibration without adding extra control-path threading.
	 */
	accel-odr = <ICM45686_DT_ACCEL_ODR_1600>;
	accel-lpf = <ICM45686_DT_ACCEL_LPF_BW_1_16>;
	gyro-odr = <ICM45686_DT_GYRO_ODR_1600>;
	gyro-lpf = <ICM45686_DT_GYRO_LPF_BW_1_8>;
	fifo-watermark = <0>;
};

&pinctrl {
	pinmux_dshot_vmu: pinmux_dshot_vmu {
		group0 {
			pinmux = <&iomuxc_gpio_emc_06_flexio1_flexio06>,
				 <&iomuxc_gpio_emc_07_flexio1_flexio07>,
				 <&iomuxc_gpio_emc_08_flexio1_flexio08>,
				 <&iomuxc_gpio_emc_09_flexio1_flexio09>,
				 <&iomuxc_gpio_emc_02_flexio1_flexio02>,
				 <&iomuxc_gpio_emc_03_flexio1_flexio03>,
				 <&iomuxc_gpio_emc_04_flexio1_flexio04>,
				 <&iomuxc_gpio_emc_05_flexio1_flexio05>;
			drive-strength = "r0-4";
			bias-pull-up;
			bias-pull-up-value = "47k";
			slew-rate = "fast";
			input-enable;
			nxp,speed = "100-mhz";
		};
	};
};

&flexio1 {
	status = "okay";

	dshot: dshot {
		compatible = "cognipilot,flexio-dshot";
		pinctrl-0 = <&pinmux_dshot_vmu>;
		pinctrl-names = "default";
		status = "okay";
		speed = <600>;

		ch1 {
			pin-id = <6>;
		};

		ch2 {
			pin-id = <7>;
		};

		ch3 {
			pin-id = <9>;
		};

		ch4 {
			pin-id = <8>;
		};
	};
};

&bmi08x_accel {
	status = "disabled";
};

&bmi08x_gyro {
	status = "disabled";
};
