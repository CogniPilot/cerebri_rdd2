#include <zephyr/dt-bindings/sensor/icm45686.h>
#include <zephyr/dt-bindings/sensor/ina226.h>

/ {
	aliases {
		rc = &sbus0;
		imu0 = &icm45686;
		power0 = &ina226;
		motors = &dshot;
		gnss = &gnss0;
		zros-serial = &lpuart4;

		/*
		 * Candidates for `zros_serial scan`, which listens on all of
		 * them at once to find which header the radio is on. Only
		 * UARTs no driver owns may be listed: the scan reconfigures
		 * the baud and polls for bytes, which would fight any driver
		 * holding the port. lpuart6 is the console, lpuart8 is CRSF,
		 * and lpuart2 belongs to the GNSS receiver in the default
		 * build, so the mocap-gnss snippet adds lpuart2 instead.
		 */
		zros-scan0 = &lpuart3;
		zros-scan1 = &lpuart4;
		zros-scan2 = &lpuart5;
	};
};

/*
 * SiK telemetry radio carrying the compact synapse serial framing. All three
 * candidate TELEM ports carry the radio's rate, not just the one the
 * zros-serial alias currently names: `zros_serial scan` configures the baud
 * itself and restores it afterwards, so a port that scans clean at 57600
 * would otherwise still come up at the devicetree default and see nothing.
 * 57600 is the SiK factory default; change all three together if the radios
 * are reconfigured.
 */
&lpuart3 {
	status = "okay";
	current-speed = <57600>;
};

&lpuart4 {
	status = "okay";
	current-speed = <57600>;
};

&lpuart5 {
	status = "okay";
	current-speed = <57600>;
};

/*
 * Onboard M10 on the 10-pin JST-GH GPS connector. Enabling this node is what
 * pulls in the Zephyr GNSS driver and makes RDD2_GNSS_SOURCE_ONBOARD the
 * default, so the gnss topic is produced here and streamed out as telemetry.
 *
 * current-speed is 115200, confirmed against the hardware: a port dump at that
 * rate returns b5 62 01 07, a u-blox UBX NAV-PVT header. Note that the module
 * therefore speaks UBX, not NMEA, so gnss-nmea-generic cannot decode it - see
 * the GNSS section of README.md. The mocap-gnss snippet disables this node,
 * which both frees the UART and switches the topic to accepting an injected
 * fix.
 */
&lpuart2 {
	status = "okay";
	current-speed = <115200>;

	gnss0: gnss {
		status = "okay";
		compatible = "cognipilot,ubx-gnss";
	};
};

/*
 * Battery monitor on the CogniPilot power module, on the I2C bus behind the
 * POWER connector. The shunt value and the current LSB below are the ones the
 * module ships with; both scale the reported current directly, so check the
 * current channel against a meter under load before trusting the telemetry.
 */
&lpi2c3 {
	ina226: ina226@41 {
		compatible = "ti,ina226";
		reg = <0x41>;
		current-lsb-microamps = <5000>;
		rshunt-micro-ohms = <500>;
	};
};

&icm45686 {
	spi-max-frequency = <10000000>;
	/*
	 * Pace the rate loop directly from the IMU data-ready interrupt at
	 * 800 Hz. The low-pass bandwidth is a fraction of the ODR, so the
	 * 1/16 accel (50 Hz) and 1/8 gyro (100 Hz) cutoffs track the new rate
	 * automatically and stay conservative enough to cut motor vibration
	 * without adding extra control-path threading.
	 */
	accel-odr = <ICM45686_DT_ACCEL_ODR_800>;
	accel-lpf = <ICM45686_DT_ACCEL_LPF_BW_1_16>;
	gyro-odr = <ICM45686_DT_GYRO_ODR_800>;
	gyro-lpf = <ICM45686_DT_GYRO_LPF_BW_1_8>;
	fifo-watermark = <0>;
};

&pinctrl {
	pinmux_dshot_vmu: pinmux_dshot_vmu {
		group0 {
			pinmux = <&iomuxc_gpio_emc_06_flexio1_flexio06>,
				 <&iomuxc_gpio_emc_07_flexio1_flexio07>,
				 <&iomuxc_gpio_emc_08_flexio1_flexio08>,
				 <&iomuxc_gpio_emc_09_flexio1_flexio09>,
				 <&iomuxc_gpio_emc_02_flexio1_flexio02>,
				 <&iomuxc_gpio_emc_03_flexio1_flexio03>,
				 <&iomuxc_gpio_emc_04_flexio1_flexio04>,
				 <&iomuxc_gpio_emc_05_flexio1_flexio05>;
			drive-strength = "r0-4";
			bias-pull-up;
			bias-pull-up-value = "47k";
			slew-rate = "fast";
			input-enable;
			nxp,speed = "100-mhz";
		};
	};
};

&flexio1 {
	status = "okay";

	dshot: dshot {
		compatible = "cognipilot,flexio-dshot";
		pinctrl-0 = <&pinmux_dshot_vmu>;
		pinctrl-names = "default";
		status = "okay";
		speed = <600>;

		ch1 {
			pin-id = <6>;
			bidirectional-dshot;
			extended-telemetry;
		};

		ch2 {
			pin-id = <7>;
			bidirectional-dshot;
			extended-telemetry;
		};

		ch3 {
			pin-id = <9>;
			bidirectional-dshot;
			extended-telemetry;
		};

		ch4 {
			pin-id = <8>;
			bidirectional-dshot;
			extended-telemetry;
		};
	};
};

&bmi08x_accel {
	status = "disabled";
};

&bmi08x_gyro {
	status = "disabled";
};

/*
 * FlexRAM split: all sixteen 32 KB banks go to the tightly coupled memories,
 * 256 KB ITCM for the hot-path code including the whole interrupt path, and
 * 256 KB DTCM for the hot-path data. OCRAM2 (512 KB) is the general RAM and
 * holds the generated navigation estimator state and the flight log ring.
 * Each image applies its own split from its reset hook, so MCUboot keeping
 * the board default does not conflict.
 */
#include <zephyr/dt-bindings/memory-controller/nxp,flexram.h>

&flexram {
	flexram,bank-spec = <FLEXRAM_DTCM>,
			    <FLEXRAM_DTCM>,
			    <FLEXRAM_DTCM>,
			    <FLEXRAM_DTCM>,
			    <FLEXRAM_DTCM>,
			    <FLEXRAM_DTCM>,
			    <FLEXRAM_DTCM>,
			    <FLEXRAM_DTCM>,
			    <FLEXRAM_ITCM>,
			    <FLEXRAM_ITCM>,
			    <FLEXRAM_ITCM>,
			    <FLEXRAM_ITCM>,
			    <FLEXRAM_ITCM>,
			    <FLEXRAM_ITCM>,
			    <FLEXRAM_ITCM>,
			    <FLEXRAM_ITCM>;
};

&itcm {
	reg = <0x00000000 DT_SIZE_K(256)>;
};

&dtcm {
	reg = <0x20000000 DT_SIZE_K(256)>;
};

/*
 * Interrupt priorities. The FlexIO DShot handler has to load the second
 * shift-buffer word and re-arm the receiver within 24 sub-bits (13 us at
 * DShot600). Every other handler on this board can run tens of
 * microseconds (IMU data-ready readout, CRSF frame parsing, DMA and SD
 * completions), so they all sit one level below FlexIO and get preempted
 * by it instead of delaying it.
 */
&edma0 {
	interrupts = <0 1>, <1 1>, <2 1>, <3 1>, <4 1>, <5 1>, <6 1>, <7 1>,
		     <8 1>, <9 1>, <10 1>, <11 1>, <12 1>, <13 1>, <14 1>,
		     <15 1>, <16 1>;
};
&gpio1 { interrupts = <80 1>, <81 1>; };
&gpio2 { interrupts = <82 1>, <83 1>; };
&gpio3 { interrupts = <84 1>, <85 1>; };
&gpio4 { interrupts = <86 1>, <87 1>; };
&gpio5 { interrupts = <88 1>, <89 1>; };
&lpuart2 { interrupts = <21 1>; };
&lpuart3 { interrupts = <22 1>; };
&lpuart4 { interrupts = <23 1>; };
&lpuart5 { interrupts = <24 1>; };
&lpuart6 { interrupts = <25 1>; };
&lpuart7 { interrupts = <26 1>; };
&lpuart8 { interrupts = <27 1>; };
&lpi2c1 { interrupts = <28 1>; };
&lpi2c3 { interrupts = <30 1>; };
&lpi2c4 { interrupts = <31 1>; };
&usdhc1 { interrupts = <110 1>; };
&enet_mac { interrupts = <114 1>; };
