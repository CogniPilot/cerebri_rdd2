choice RDD2_GNSS_SOURCE
	prompt "Source for the gnss topic"
	default RDD2_GNSS_SOURCE_ONBOARD if DT_HAS_COGNIPILOT_UBX_GNSS_ENABLED
	default RDD2_GNSS_SOURCE_LOCKSTEP if RDD2_LOCKSTEP
	default RDD2_GNSS_SOURCE_RADIO
	help
	  Which producer publishes the gnss_fix topic. The sources are mutually
	  exclusive by construction: the choice decides which one registers as
	  the topic's single publisher, so a fix can only ever have one origin
	  and an injected fix cannot silently race an onboard one.

config RDD2_GNSS_SOURCE_RADIO
	bool "Injected over the zros serial link"
	help
	  The serial transport carries the gnss_fix topic inbound and is its
	  registered publisher. A ground station or a mocap bridge supplies the
	  fix over the radio. This is the right choice for indoor flight, where
	  the receiver may be plugged in but has no sky view and position comes
	  from motion capture instead.

	  Reached with the mocap-gnss snippet, which also disables the
	  devicetree gnss node so the reader is not compiled in and its UART
	  stays free.

config RDD2_GNSS_SOURCE_ONBOARD
	bool "Onboard u-blox receiver read as UBX"
	depends on DT_HAS_COGNIPILOT_UBX_GNSS_ENABLED
	select RING_BUFFER
	select UART_INTERRUPT_DRIVEN
	help
	  This reader publishes the gnss_fix topic and the serial transport
	  streams it out as telemetry. This is the default whenever the
	  devicetree gnss node is enabled.

	  Configures the M10 deterministically over UBX-CFG-VALSET, then decodes
	  UBX-NAV-PVT. Boot configuration enables UBX on receiver UART1 at
	  115200 baud, disables NMEA output, selects the airborne 2g dynamics
	  model, and requests NAV-PVT at 10 Hz. Configuration ACK, fix quality,
	  accuracy, age, and observed rate all remain fail-closed readiness gates.

	  Once ready, NAV-PVT publishes the accuracy estimates NMEA cannot express.
	  Before readiness or after a gate drops, the topic is actively refreshed
	  as NoFix with unusable accuracy sentinels so consumers cannot replay an
	  earlier usable sample.

	  The receiver's serial rate must match current-speed on the parent
	  UART.

config RDD2_GNSS_SOURCE_LOCKSTEP
	bool "Injected by deterministic lockstep"
	depends on RDD2_LOCKSTEP
	help
	  The lockstep coordinator publishes a synthetic 10 Hz GNSS fix in the
	  simulated boot-time domain. This source owns an immutable GPS origin and
	  disables external odometry like the onboard receiver; it is not a radio
	  or motion-capture compatibility profile.

config RDD2_GNSS_SOURCE_MESH
	bool "Received over the mesh from the rtk_gnss grandmaster"
	depends on CSYN
	help
	  The system GNSS fix arrives over the network. The rtk_gnss grandmaster
	  publishes GnssFixData on the shared "gnss" key, CSyn delivers it into
	  its lock-free latest-sample store, and this backend identity-copies each
	  newly received sample onto the gnss_fix topic as its single publisher.

	  This is the right choice for a mesh node with no local sky view that
	  takes position, corrections, and time from the fleet. The serial
	  transport still streams gnss_fix outbound as telemetry.

endchoice

if RDD2_GNSS_SOURCE_ONBOARD

config RDD2_GNSS_UBX_MAX_PAYLOAD
	int "Largest UBX payload buffered"
	default 160
	range 144 512
	help
	  The complete boot CFG-VALSET payload is 144 bytes and NAV-PVT is 92
	  bytes. Larger frames from other message classes are counted and skipped
	  in their entirety rather than buffered, including their checksums.

config RDD2_GNSS_UBX_RX_RING_SIZE
	int "Receive ring buffer size in bytes"
	default 512
	range 128 4096
	help
	  Must hold one poll period of line rate: at 115200 baud a 5 ms period
	  is about 58 bytes, so the default leaves generous headroom for burst
	  arrival.

config RDD2_GNSS_UBX_POLL_MS
	int "Reader thread poll period in milliseconds"
	default 5
	range 1 100
	help
	  The same low-priority polling loop drains received bytes and advances
	  bounded configuration retry/timeout state. It never waits synchronously
	  for an ACK.

config RDD2_GNSS_UBX_THREAD_PRIORITY
	int "Reader thread priority"
	default 7
	help
	  Must stay preemptible and below the control loop. A cooperative
	  (negative) priority here would let NMEA/UBX parsing block the
	  1600 Hz loop, which SPEC_0002 and SPEC_0005 forbid.

config RDD2_GNSS_UBX_THREAD_STACK_SIZE
	int "Reader thread stack size"
	default 1536
	range 1024 8192

endif

if RDD2_GNSS_SOURCE_MESH

config RDD2_GNSS_MESH_POLL_MS
	int "Mesh GNSS poll period in milliseconds"
	default 50
	range 1 1000
	help
	  Cadence at which the backend checks the CSyn "gnss" store for a newly
	  received producer generation. The grandmaster publishes at a low rate,
	  so a poll well under the publish period bounds end-to-end latency
	  without busy-waiting.

config RDD2_GNSS_MESH_THREAD_PRIORITY
	int "Mesh GNSS thread priority"
	default 7
	help
	  Must stay preemptible and below the control loop. A cooperative
	  (negative) priority here would let the copy block the 1600 Hz loop,
	  which SPEC_0002 and SPEC_0005 forbid.

config RDD2_GNSS_MESH_THREAD_STACK_SIZE
	int "Mesh GNSS thread stack size"
	default 1536
	range 1024 8192

endif
