config RDD2_ZROS_SERIAL
	bool "Enable the synapse serial transport"
	depends on ZROS
	depends on SERIAL
	depends on SERIAL_SUPPORT_INTERRUPT
	select UART_INTERRUPT_DRIVEN
	select RING_BUFFER
	select CRC
	default n
	help
	  Carry ZROS topics over a plain UART using the compact synapse
	  serial framing described in fbs/transport.fbs:
	  [sync][len][topic_id][seq][flags][bare payload][crc16].

	  This is the transport for constrained links such as a SiK
	  telemetry radio. Inbound frames are published onto ZROS, outbound
	  topics are read from ZROS and rate limited to fit the air rate.
	  Requires a "zros-serial" devicetree alias naming the UART.

	  CSyn is not involved. The wire ids are synapse catalog TopicIds,
	  which is schema shared with the ground-side peer, not a dependency
	  on the CSyn transport: that one carries the same topics over
	  Ethernet and Zenoh independently of this link.

if RDD2_ZROS_SERIAL

config RDD2_ZROS_SERIAL_MAX_PAYLOAD
	int "Largest topic payload carried over the serial link"
	default 128
	range 8 512
	help
	  Frames with a larger payload are dropped and counted. Fixed-layout
	  struct topics are at most 64 bytes in synapse_fbs 0.7, so the
	  default leaves headroom without reserving a full flatbuffer buffer.

config RDD2_ZROS_SERIAL_TX_MIN_INTERVAL_MS
	int "Minimum milliseconds between frames of the same topic"
	default 200
	range 0 10000
	help
	  Per-topic decimation for the outbound direction. The flight state
	  topics publish at 200 Hz, which is roughly seven times what a
	  57600 baud SiK link can carry, so outbound topics are throttled
	  rather than dropped at the UART. 200 ms gives 5 Hz per topic.

config RDD2_ZROS_SERIAL_RX_RING_SIZE
	int "Receive ring buffer size in bytes"
	default 512
	range 64 4096

config RDD2_ZROS_SERIAL_TX_RING_SIZE
	int "Transmit ring buffer size in bytes"
	default 1024
	range 64 8192

config RDD2_ZROS_SERIAL_POLL_MS
	int "Transport thread poll period in milliseconds"
	default 5
	range 1 100

config RDD2_ZROS_SERIAL_THREAD_PRIORITY
	int "Transport thread priority"
	default 7
	help
	  Must stay below the control loop and the CRSF input thread. The
	  transport never touches the rate loop.

config RDD2_ZROS_SERIAL_THREAD_STACK_SIZE
	int "Transport thread stack size"
	default 2048
	range 1024 8192

endif
