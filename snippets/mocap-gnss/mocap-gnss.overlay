/*
 * Take the gnss topic from an injected fix instead of the onboard receiver:
 * motion capture or a ground station supplies it over the telemetry radio.
 *
 * Disabling the node drops CONFIG_GNSS_NMEA_GENERIC, so the driver and its
 * modem chat machinery are not compiled at all and lpuart2 stays free. That
 * also makes lpuart2 scannable with `csyn_serial scan`, which is the easy way
 * to find what serial rate the receiver is actually running at before
 * switching back to the onboard default.
 */

&gnss0 {
	status = "disabled";
};

/ {
	aliases {
		/*
		 * With the receiver gone lpuart2 has no owner, so it becomes a
		 * legal scan target. This is how you find what serial rate the
		 * receiver actually runs at before switching back to onboard.
		 */
		csyn-scan3 = &lpuart2;
	};
};
