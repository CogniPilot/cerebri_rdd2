source "Kconfig.zephyr"

config TOP_SHELL
    bool "Enable top-like screen in shell"
    depends on SHELL
    default y

config PWM_FREQUENCY
    int "PWM motors frequency in Hz"
    depends on PWM
    default 400
    
menu "RDD2"

config RDD2_COMMS_STUB
	bool "Build the non-flyable communications bench image"
	default n
	help
	  Build only the real sensor, GNSS, ZROS, CSyn, serial telemetry, and
	  shell paths. Generated flight-control containers are not compiled.
	  Navigation publications are explicitly invalid, vehicle health is
	  permanently disarmed/failsafe, and the motor driver is replaced by a
	  publisher that can only emit zero/disarmed output. This image is for
	  communications and timing bench work and must never be used for flight.

rsource "subsys/Kconfig"
rsource "drivers/Kconfig"

endmenu
