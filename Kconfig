# Session files reach the rotation size, 4095 MiB by default and far past the
# mcumgr FS group's 64KB default cap.
# When the SD flight logger is built, force the transfer-size choice to its 4GB
# member so a full session is downloadable, which also widens
# MCUMGR_GRP_FS_MAX_OFFSET_LEN. This override precedes Kconfig.zephyr so its
# choice default is evaluated before the upstream 64KB default and therefore
# wins. It stays inert for the passive image, where the FS group is absent.
choice MCUMGR_GRP_FS_MAX_FILE_SIZE
	default MCUMGR_GRP_FS_MAX_FILE_SIZE_4GB if RDD2_FLIGHT_LOG
endchoice

source "Kconfig.zephyr"

config TOP_SHELL
    bool "Enable top-like screen in shell"
    depends on SHELL
    default y

config PWM_FREQUENCY
    int "PWM motors frequency in Hz"
    depends on PWM
    default 400
    
menu "RDD2"

config RDD2_COMMS_STUB
	bool "Build the passive communications endpoint"
	default n
	help
	  Build only ZROS storage, network receivers, timing, diagnostics, and
	  shell access. Flight-control containers, local sensor polling, RC input,
	  motor output, and periodic stub publications are not compiled. The main
	  thread sleeps forever while the event-driven communications endpoints
	  receive data.

choice RDD2_CONTROL_BACKEND
	prompt "Flight control backend"
	depends on !RDD2_COMMS_STUB
	default RDD2_CONTROL_EFMI
	help
	  Select the compute cores behind the estimator, guidance, allocator, and
	  planner processes. The ZROS topic surface, arming state machine, safety
	  gates, and driver bindings are identical for both selections.

config RDD2_CONTROL_EFMI
	bool "Generated eFMI control models"
	help
	  Use the eFMI control models generated from the shared Modelica library.
	  This is the default flight configuration and requires the
	  modelica_models west project to be checked out.

config RDD2_CONTROL_SIMPLE
	bool "Hand-written stand-in control backend"
	depends on !RDD2_LOCKSTEP
	help
	  Use hand-written stand-in compute cores in place of the generated eFMI
	  models. The estimator runs a complementary attitude filter with GNSS and
	  optical-flow passthrough, guidance runs an attitude-P loop, and the
	  allocator runs a rate-P loop with fixed X-quad mixing. Gains are
	  deliberately conservative bench placeholders. This lets the complete
	  flight image link without the generated models for bench verification of
	  sign conventions and data flow. Hardware builds only: this backend omits
	  the lockstep health-time remap the generated estimator performs, so it is
	  unavailable when RDD2_LOCKSTEP is set.

endchoice

config RDD2_MAGNETOMETER
	bool "Feed the onboard magnetometer to the navigation estimator"
	depends on !RDD2_COMMS_STUB && !RDD2_LOCKSTEP && SENSOR
	default y if BMM350 || IST8310
	help
	  Sample the onboard magnetometer at a fixed rate, publish it as the
	  magnetic_field topic in body FLU tesla, log it, and offer it to the
	  navigation estimator, which takes its initial heading from it and fuses
	  it as a yaw observation. Without it the estimator has no heading source
	  indoors and its yaw is arbitrary. The lockstep image has no I2C device
	  behind the driver, so it stays off there.

if RDD2_MAGNETOMETER

choice RDD2_MAGNETOMETER_DEVICE
	prompt "Magnetometer device"
	default RDD2_MAGNETOMETER_BMM350 if BMM350
	default RDD2_MAGNETOMETER_IST8310

config RDD2_MAGNETOMETER_BMM350
	bool "BMM350 (LPI2C4)"
	depends on BMM350

config RDD2_MAGNETOMETER_IST8310
	bool "IST8310 (LPI2C1)"
	depends on IST8310

endchoice

config RDD2_MAGNETOMETER_RATE_HZ
	int "Sample rate in Hz"
	default 50
	range 5 200

config RDD2_MAGNETOMETER_STDDEV_NT
	int "Per-axis measurement noise standard deviation in nT"
	default 300
	help
	  Reported to the estimator as an isotropic measurement covariance. Set
	  it from the field scatter measured on the resting aircraft with motors
	  off; the estimator's innovation gate handles the rest.

choice RDD2_MAGNETOMETER_MOUNT_YAW
	prompt "Rotation from the sensor axes to the body FLU frame about z"
	default RDD2_MAGNETOMETER_MOUNT_YAW_90
	help
	  The 90 degree default is the mapping the IMU interface applies to the
	  ICM45686 on this board (body x is sensor y, body y is -sensor x).
	  Verify it on the bench with the aircraft pointed at a known heading
	  before trusting the magnetic heading.

config RDD2_MAGNETOMETER_MOUNT_YAW_0
	bool "0 degrees"

config RDD2_MAGNETOMETER_MOUNT_YAW_90
	bool "90 degrees"

config RDD2_MAGNETOMETER_MOUNT_YAW_180
	bool "180 degrees"

config RDD2_MAGNETOMETER_MOUNT_YAW_270
	bool "270 degrees"

endchoice

config RDD2_MAGNETOMETER_Z_INVERTED
	bool "Sensor z axis points down"
	default n

endif # RDD2_MAGNETOMETER

rsource "subsys/Kconfig"
rsource "drivers/Kconfig"

endmenu
