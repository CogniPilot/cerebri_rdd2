source "Kconfig.zephyr"

config TOP_SHELL
    bool "Enable top-like screen in shell"
    depends on SHELL
    default y

config PWM_FREQUENCY
    int "PWM motors frequency in Hz"
    depends on PWM
    default 400
    
menu "RDD2"

config RDD2_COMMS_STUB
	bool "Build the passive communications endpoint"
	default n
	help
	  Build only ZROS storage, network receivers, timing, diagnostics, and
	  shell access. Flight-control containers, local sensor polling, RC input,
	  motor output, and periodic stub publications are not compiled. The main
	  thread sleeps forever while the event-driven communications endpoints
	  receive data.

choice RDD2_CONTROL_BACKEND
	prompt "Flight control backend"
	depends on !RDD2_COMMS_STUB
	default RDD2_CONTROL_EFMI
	help
	  Select the compute cores behind the estimator, guidance, allocator, and
	  planner processes. The ZROS topic surface, arming state machine, safety
	  gates, and driver bindings are identical for both selections.

config RDD2_CONTROL_EFMI
	bool "Generated eFMI control models"
	help
	  Use the eFMI control models generated from the shared Modelica library.
	  This is the default flight configuration and requires the
	  modelica_models west project to be checked out.

config RDD2_CONTROL_SIMPLE
	bool "Hand-written stand-in control backend"
	help
	  Use hand-written stand-in compute cores in place of the generated eFMI
	  models. The estimator runs a complementary attitude filter with GNSS and
	  optical-flow passthrough, guidance runs an attitude-P loop, and the
	  allocator runs a rate-P loop with fixed X-quad mixing. Gains are
	  deliberately conservative bench placeholders. This lets the complete
	  flight image link without the generated models for bench verification of
	  sign conventions and data flow.

endchoice

rsource "subsys/Kconfig"
rsource "drivers/Kconfig"

endmenu
