source "Kconfig.zephyr"

config TOP_SHELL
    bool "Enable top-like screen in shell"
    depends on SHELL
    default y

config PWM_FREQUENCY
    int "PWM motors frequency in Hz"
    depends on PWM
    default 400
    
menu "RDD2"

config RDD2_COMMS_STUB
	bool "Build the passive communications endpoint"
	default n
	help
	  Build only ZROS storage, network receivers, timing, diagnostics, and
	  shell access. Flight-control containers, local sensor polling, RC input,
	  motor output, and periodic stub publications are not compiled. The main
	  thread sleeps forever while the event-driven communications endpoints
	  receive data.

rsource "subsys/Kconfig"
rsource "drivers/Kconfig"

endmenu
